			"link": null,
			"locked": false,
			"text": "output = [1] * len(s)\naccum = 1\nfor i in range(len(nums)):\n    accum *= nums[i]\n\nfor i in range(len(nums)):\n    output[i] = accum - num[i]**2",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "output = [1] * len(s)\naccum = 1\nfor i in range(len(nums)):\n    accum *= nums[i]\n\nfor i in range(len(nums)):\n    output[i] = accum - num[i]**2",
			"autoResize": true,
			"lineHeight": 1.25,
