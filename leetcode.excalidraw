			"updated": 1774574391135,
			"link": null,
			"locked": false,
			"text": "step 2: justify each line\nfor each groups of words, build the justified string",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "step 2: justify each line\nfor each groups of words, build the justified string",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "iM65h5ye",
			"type": "text",
			"x": 3692.43220040313,
			"y": 10786.56660021557,
			"width": 346.259765625,
			"height": 200,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [
				"vUPlaeW6C9imf1xfeEaaL"
			],
			"frameId": null,
			"index": "bK2",
			"roundness": null,
			"seed": 2127423677,
			"version": 591,
			"versionNonce": 2066204438,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1774574391135,
			"link": null,
			"locked": false,
			"text": "the space distribution formula\n\ntotal_chars = sum(len(w) for w in line)\ngaps = len(line) - 1\nextra_spaces = maxWidth - total_chars\n\nmin_spaces = extra_spaces // gaps\nleftover = extra_spaces % gaps",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "the space distribution formula\n\ntotal_chars = sum(len(w) for w in line)\ngaps = len(line) - 1\nextra_spaces = maxWidth - total_chars\n\nmin_spaces = extra_spaces // gaps\nleftover = extra_spaces % gaps",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
