			"updated": 1772070548720,
			"link": null,
			"locked": false,
			"text": "min = { index: 0, val: inf }\nmax = { index: 0, val: -1 } \n\nfor i in range(len(prices)):\n    if price < min['val']:\n        min['index'] = i\n        min['val'] = price    \n    elseif price >= max['val'] and i > min['index']:\n        max['index'] = i\n        max['val'] = price\n    ",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "min = { index: 0, val: inf }\nmax = { index: 0, val: -1 } \n\nfor i in range(len(prices)):\n    if price < min['val']:\n        min['index'] = i\n        min['val'] = price    \n    elseif price >= max['val'] and i > min['index']:\n        max['index'] = i\n        max['val'] = price\n    ",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
