		{
			"id": "6q3ijn0B",
			"type": "text",
			"x": 9149.47367580399,
			"y": 1547.9606784318673,
			"width": 366.11328125,
			"height": 325,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b2A",
			"roundness": null,
			"seed": 10088197,
			"version": 278,
			"versionNonce": 504508971,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773260696917,
			"link": null,
			"locked": false,
			"text": "```python\nbin_n = bin(n)\n# drop the first 2 characters \"0b\"\nbin_n_str = str(bin_n)[2::] \ncomplement = \"\"\n\nfor bit in bit_n_str\n    complement += \"0\" if bit == \"1\" else \"1\"\n\ncomplement = int(complement, 2)\n\nreturn complement\n```",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "```python\nbin_n = bin(n)\n# drop the first 2 characters \"0b\"\nbin_n_str = str(bin_n)[2::] \ncomplement = \"\"\n\nfor bit in bit_n_str\n    complement += \"0\" if bit == \"1\" else \"1\"\n\ncomplement = int(complement, 2)\n\nreturn complement\n```",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "5l80lLbJ",
			"type": "text",
			"x": 9153.693280933354,
			"y": 1947.7682644379738,
			"width": 442.59765625,
			"height": 500,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b2B",
			"roundness": null,
			"seed": 741096971,
			"version": 19,
			"versionNonce": 1202144773,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773262214421,
			"link": null,
			"locked": false,
			"text": "```go\nfunc bitwiseComplement(n int) int {\n    // Get binary string representation\n    binStr := strconv.FormatInt(int64(n), 2)\n\n    // Build complement string\n    complement := \"\"\n    for _, bit := range binStr {\n        if bit == '1' {\n            complement += \"0\"\n        } else {\n            complement += \"1\"\n        }\n    }\n\n    // Parse binary string back to int\n    result, _ := strconv.ParseInt(complement, 2, 64)\n    return int(result)\n}\n```",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "```go\nfunc bitwiseComplement(n int) int {\n    // Get binary string representation\n    binStr := strconv.FormatInt(int64(n), 2)\n\n    // Build complement string\n    complement := \"\"\n    for _, bit := range binStr {\n        if bit == '1' {\n            complement += \"0\"\n        } else {\n            complement += \"1\"\n        }\n    }\n\n    // Parse binary string back to int\n    result, _ := strconv.ParseInt(complement, 2, 64)\n    return int(result)\n}\n```",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
