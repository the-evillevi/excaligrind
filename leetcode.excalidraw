		{
			"id": "gVH0Yw8U",
			"type": "text",
			"x": 1945.5345812580044,
			"y": 8619.653809408463,
			"width": 578.017578125,
			"height": 225,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
