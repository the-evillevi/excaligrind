			"boundElements": [],
			"updated": 1772480387591,
			"link": null,
			"locked": false,
			"text": "the row with n-1 zeroes on the right should be top\nnext, row with n-2 zeroes on the right\n...\nnext, row with n-m zeroes on the right\n\nlast row doesn't matter",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "the row with n-1 zeroes on the right should be top\nnext, row with n-2 zeroes on the right\n...\nnext, row with n-m zeroes on the right\n\nlast row doesn't matter",
			"autoResize": true,
