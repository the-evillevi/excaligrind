			"link": null,
			"locked": false,
			"text": "if nums[idx1] == 0 and nums[idx2] != 0:\n    # swap\n    nums[idx1], nums[idx2] = nums[idx2], nums[idx1]\n    idx1, idx2 += 1, 1\nelif nums[idx1] == 0 and nums[idx2] == 0:\n    idx2 += 1",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "if nums[idx1] == 0 and nums[idx2] != 0:\n    # swap\n    nums[idx1], nums[idx2] = nums[idx2], nums[idx1]\n    idx1, idx2 += 1, 1\nelif nums[idx1] == 0 and nums[idx2] == 0:\n    idx2 += 1",
