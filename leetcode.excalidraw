			"updated": 1774574391135,
			"link": null,
			"locked": false,
			"text": "edge cases\n\n1. single word on line (gaps == 0):\n    pad right with spaces to fill maxWidth\n\n2. left-justify:\n    join words with single spaces, pad right",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "edge cases\n\n1. single word on line (gaps == 0):\n    pad right with spaces to fill maxWidth\n\n2. left-justify:\n    join words with single spaces, pad right",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
