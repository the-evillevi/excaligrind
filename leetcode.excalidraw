			"boundElements": [],
			"updated": 1774665639529,
			"link": null,
			"locked": false,
			"text": "if nums[0] > nums[2]:\n    nums[0], nums[2] = nums[2], nums[0]\nwait, this is disordering the array, gotta go check merge sort algo\n...\nok, so, do not swap when a greater number is found, instead,\nmove the lower number to i, then bubble the rest of the numbers up.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "if nums[0] > nums[2]:\n    nums[0], nums[2] = nums[2], nums[0]\nwait, this is disordering the array, gotta go check merge sort algo\n...\nok, so, do not swap when a greater number is found, instead,\nmove the lower number to i, then bubble the rest of the numbers up.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
