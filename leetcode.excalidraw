		{
			"id": "Jt7vGQCV",
			"type": "text",
			"x": 8698.333102071403,
			"y": 10827.085402790944,
			"width": 256.787109375,
			"height": 25,
			"angle": 0,
			"strokeColor": "#ffffff",
