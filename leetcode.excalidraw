		{
			"id": "QFQYuo4I",
			"type": "text",
			"x": -46.60257498545291,
			"y": 8578.300340673493,
			"width": 584.775390625,
			"height": 300,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
