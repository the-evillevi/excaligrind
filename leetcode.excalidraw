		{
			"id": "Acmtn41T",
			"type": "text",
			"x": -34.25378805888727,
			"y": 13429.396961978884,
			"width": 493.603515625,
			"height": 575,
			"angle": 0,
			"strokeColor": "#b2f2bb",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "bDC",
			"roundness": null,
			"seed": 1189935726,
			"version": 849,
			"versionNonce": 1583529929,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1774407852395,
			"link": null,
			"locked": false,
			"text": "# row, column pairs will tell the us the delta at each step\n# east, south, west, north\ndirections = [[0, 1], [1, 0], [0, -1], [-1, 0]] \n\noutput = []\n\nr, c = rStart, cStart\nsteps = 1\n# index to iterate directions\ni = 0\n\nwhile len(output) < rows * cols:\n    dr, dc = directions[i]\n    for _ in range(steps):\n        if 0 <= r < rows and 0 <= c < cols:\n            output.append([r, c])\n        r, c = r + dr, c + dc\n\n    # never go out of bounds of directions\n    i = (i + 1) % len(directions) \n    steps += 1 if i % 2 != 0 else 0\n\nreturn output",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "# row, column pairs will tell the us the delta at each step\n# east, south, west, north\ndirections = [[0, 1], [1, 0], [0, -1], [-1, 0]] \n\noutput = []\n\nr, c = rStart, cStart\nsteps = 1\n# index to iterate directions\ni = 0\n\nwhile len(output) < rows * cols:\n    dr, dc = directions[i]\n    for _ in range(steps):\n        if 0 <= r < rows and 0 <= c < cols:\n            output.append([r, c])\n        r, c = r + dr, c + dc\n\n    # never go out of bounds of directions\n    i = (i + 1) % len(directions) \n    steps += 1 if i % 2 != 0 else 0\n\nreturn output",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
