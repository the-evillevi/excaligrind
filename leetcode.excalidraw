		},
		{
			"id": "kKm8wjRJ",
			"type": "text",
			"x": 4800.699862234687,
			"y": 6413.485940558858,
			"width": 389.08203125,
			"height": 400,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b5f",
			"roundness": null,
			"seed": 1000596398,
			"version": 939,
			"versionNonce": 780747822,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773547629770,
			"link": null,
			"locked": false,
			"text": "if nums[idx1] == nums[idx2]:\n    # then we have two equal items\n    if idx1 < idx2:\n        # two of this item, move idx1\n        idx1 = idx2 + 1\n    elif idx1 > idx2:\n        # item appears more than twice, delete\n        del nums[idx1]\n        idx1 += 1\nelif nums[idx1] > nums[idx2]:\n    # we found an increment, move idx2\n    idx2 = idx1 + 1\nelif nums[idx1] < nums[idx2]:\n    # increment found, move both\n    idx1 += 1\n    idx2 += 1",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "if nums[idx1] == nums[idx2]:\n    # then we have two equal items\n    if idx1 < idx2:\n        # two of this item, move idx1\n        idx1 = idx2 + 1\n    elif idx1 > idx2:\n        # item appears more than twice, delete\n        del nums[idx1]\n        idx1 += 1\nelif nums[idx1] > nums[idx2]:\n    # we found an increment, move idx2\n    idx2 = idx1 + 1\nelif nums[idx1] < nums[idx2]:\n    # increment found, move both\n    idx1 += 1\n    idx2 += 1",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "FX7hgg45",
