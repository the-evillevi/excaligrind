			"seed": 81469746,
			"version": 338,
			"versionNonce": 924141106,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773869341193,
			"link": null,
			"locked": false,
			"text": "Given an integer array `nums`, return an array `answer` such that\n`answer[i]` is equal to the product of all the elements of nums\nexcept `nums[i]`.\n\nThe product of any prefix or suffix of `nums` is guaranteed to\nfit in a 32-bit integer.\n\nYou must write an algorithm that runs in O(n) time and without\nusing the division operation.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Given an integer array `nums`, return an array `answer` such that\n`answer[i]` is equal to the product of all the elements of nums\nexcept `nums[i]`.\n\nThe product of any prefix or suffix of `nums` is guaranteed to\nfit in a 32-bit integer.\n\nYou must write an algorithm that runs in O(n) time and without\nusing the division operation.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "sScILrez",
			"type": "text",
			"x": 1943.1095493473858,
			"y": 8892.470866439098,
			"width": 199.5703125,
			"height": 100,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
