			"isDeleted": false,
			"boundElements": [],
			"updated": 1774574373089,
			"link": null,
			"locked": false,
			"text": "Given an array nums of n integers, return an array of all the\nunique quadruplets [nums[a], nums[b], nums[c], nums[d]] such that:\n\n- 0 <= a, b, c, d < n\n- a, b, c, and d are distinct.\n- nums[a] + nums[b] + nums[c] + nums[d] == target\n\nYou may return the answer in any order.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Given an array nums of n integers, return an array of all the\nunique quadruplets [nums[a], nums[b], nums[c], nums[d]] such that:\n\n- 0 <= a, b, c, d < n\n- a, b, c, and d are distinct.\n- nums[a] + nums[b] + nums[c] + nums[d] == target\n\nYou may return the answer in any order.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "Cj2vc5r0",
			"type": "text",
			"x": 8677.494374938164,
			"y": 8874.034018345377,
			"width": 342.421875,
			"height": 100,
			"angle": 0,
			"strokeColor": "#ffffff",
