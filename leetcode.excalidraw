			"updated": 1773689672741,
			"link": null,
			"locked": false,
			"text": "n = 2\n2**2 = 4\n4**2 = 16\n1**2 + 6**2 = 36\n3**2 + 6**2 = 45\n4**2 + 5**2 = 41\n4**2 + 1**2 = 17\n1**2 + 7**2 = 50\n5**2 + 0**2 = 25\n2**2 + 5**2 = 29\n2**2 + 9**2 = 85",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "n = 2\n2**2 = 4\n4**2 = 16\n1**2 + 6**2 = 36\n3**2 + 6**2 = 45\n4**2 + 5**2 = 41\n4**2 + 1**2 = 17\n1**2 + 7**2 = 50\n5**2 + 0**2 = 25\n2**2 + 5**2 = 29\n2**2 + 9**2 = 85",
