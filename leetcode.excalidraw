			"link": null,
			"locked": false,
			"text": "Given a string s and an integer k, reverse the first k characters for\nevery 2k characters counting from the start of the string.\n\nIf there are fewer than k characters left, reverse all of them.\nIf there are less than 2k but greater than or equal to k characters,\nthen reverse the first k characters and leave the other as original.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Given a string s and an integer k, reverse the first k characters for\nevery 2k characters counting from the start of the string.\n\nIf there are fewer than k characters left, reverse all of them.\nIf there are less than 2k but greater than or equal to k characters,\nthen reverse the first k characters and leave the other as original.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
