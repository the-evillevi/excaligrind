		},
		{
			"id": "ZHrUfRIuOPNsQ4-UVNBoC",
			"type": "line",
			"x": 7364.315732065354,
			"y": 1430.4376663533628,
			"width": 626.625,
			"height": 4.765625,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b1F",
			"roundness": {
				"type": 2
			},
			"seed": 812581200,
			"version": 1887,
			"versionNonce": 919522224,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772858847586,
			"link": null,
			"locked": false,
			"points": [
				[
					0,
					0
				],
				[
					626.625,
					-4.765625
				]
			],
			"startBinding": null,
