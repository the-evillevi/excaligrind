		{
			"id": "pKqiW2Br",
			"type": "text",
			"x": 9561.593109263076,
			"y": 5151.811079634502,
			"width": 594.4921875,
			"height": 575,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b99",
			"roundness": null,
			"seed": 1824307822,
			"version": 11,
			"versionNonce": 707806574,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773712536348,
			"link": null,
			"locked": false,
			"text": "class Solution:\n    def search(self, nums: List[int], target: int) -> int:\n        \n        def solve(lo, hi):\n            if lo >= hi:\n                #print(f\"lo={lo}, hi={hi}, nums[lo]={nums[lo]}\")\n                return lo if nums[lo] == target else -1\n            \n            mid = lo + (hi - lo) // 2\n\n            #print(f\"lo={lo}, mid={mid}, hi={hi}, nums[mid]={nums[mid]}\")\n            if nums[mid] == target:\n                #print(f\"this is the target, return mid={mid}\")    \n                return mid\n            elif nums[mid] > target:\n                #print(\"target is lower, move left\")\n                return solve(lo, mid)\n            elif nums[mid] < target:\n                #print(\"target is higher, move right\")\n                return solve(mid+1, hi)\n\n        return solve(0, len(nums)-1)\n",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "class Solution:\n    def search(self, nums: List[int], target: int) -> int:\n        \n        def solve(lo, hi):\n            if lo >= hi:\n                #print(f\"lo={lo}, hi={hi}, nums[lo]={nums[lo]}\")\n                return lo if nums[lo] == target else -1\n            \n            mid = lo + (hi - lo) // 2\n\n            #print(f\"lo={lo}, mid={mid}, hi={hi}, nums[mid]={nums[mid]}\")\n            if nums[mid] == target:\n                #print(f\"this is the target, return mid={mid}\")    \n                return mid\n            elif nums[mid] > target:\n                #print(\"target is lower, move left\")\n                return solve(lo, mid)\n            elif nums[mid] < target:\n                #print(\"target is higher, move right\")\n                return solve(mid+1, hi)\n\n        return solve(0, len(nums)-1)\n",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
