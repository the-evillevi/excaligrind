		{
			"id": "ZGRf3Qud",
			"type": "text",
			"x": 5815.448818514811,
			"y": 10917.51371623776,
			"width": 516.953125,
			"height": 875,
			"angle": 0,
			"strokeColor": "#b2f2bb",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "bLm",
			"roundness": null,
			"seed": 5089011,
			"version": 665,
			"versionNonce": 739402646,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1774574379902,
			"link": null,
			"locked": false,
			"text": "from collections import deque\n\nm, n = len(grid), len(grid[0])\nseen = set()\ndirections = [[0, 1], [1, 0], [0, -1], [-1, 0]]\nisland_queue = deque()\nisland_count = 0\n\ndef is_bounded(row, col):\n    if 0 <= row < m and 0 <= col < n:\n        return True\n    return False        \n\nfor row in range(m):\n    for col in range(n):\n        if grid[row][col] == \"1\" and (row, col) not in seen:\n            island_count += 1\n            island_queue.append((row, col))\n            seen.add((row, col))\n\n            while island_queue:\n                land_row, land_col = island_queue.popleft()\n\n                for dr, dc in directions:\n                    next_row = land_row + dr\n                    next_col = land_col + dc  \n                    if (\n                        is_bounded(next_row, next_col)\n                        and (next_row, next_col) not in seen\n                        and grid[next_row][next_col] == \"1\"\n                    ):\n                        island_queue.append((next_row, next_col))\n                        seen.add((next_row, next_col))\n\nreturn island_count",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "from collections import deque\n\nm, n = len(grid), len(grid[0])\nseen = set()\ndirections = [[0, 1], [1, 0], [0, -1], [-1, 0]]\nisland_queue = deque()\nisland_count = 0\n\ndef is_bounded(row, col):\n    if 0 <= row < m and 0 <= col < n:\n        return True\n    return False        \n\nfor row in range(m):\n    for col in range(n):\n        if grid[row][col] == \"1\" and (row, col) not in seen:\n            island_count += 1\n            island_queue.append((row, col))\n            seen.add((row, col))\n\n            while island_queue:\n                land_row, land_col = island_queue.popleft()\n\n                for dr, dc in directions:\n                    next_row = land_row + dr\n                    next_col = land_col + dc  \n                    if (\n                        is_bounded(next_row, next_col)\n                        and (next_row, next_col) not in seen\n                        and grid[next_row][next_col] == \"1\"\n                    ):\n                        island_queue.append((next_row, next_col))\n                        seen.add((next_row, next_col))\n\nreturn island_count",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
