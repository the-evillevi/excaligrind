			"index": "b4n",
			"roundness": null,
			"seed": 1570396462,
			"version": 399,
			"versionNonce": 1205004782,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773547629770,
			"link": null,
			"locked": false,
			"text": "Given a 1-indexed array of integers numbers that is already sorted\nin non-decreasing order, find two numbers such that they add up\nto a specific target number. Let these two numbers be numbers[index1]\nand numbers[index2] where 1 <= index1 < index2 <= numbers.length.\n\nReturn the indices of the two numbers index1 and index2, each\nincremented by one, as an integer array [index1, index2] of length 2.\n\nThe tests are generated such that there is exactly one solution.\nYou may not use the same element twice.\n\nYour solution must use only constant extra space.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Given a 1-indexed array of integers numbers that is already sorted\nin non-decreasing order, find two numbers such that they add up\nto a specific target number. Let these two numbers be numbers[index1]\nand numbers[index2] where 1 <= index1 < index2 <= numbers.length.\n\nReturn the indices of the two numbers index1 and index2, each\nincremented by one, as an integer array [index1, index2] of length 2.\n\nThe tests are generated such that there is exactly one solution.\nYou may not use the same element twice.\n\nYour solution must use only constant extra space.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "L6H5EG7K",
			"type": "text",
			"x": 3788.1432217692254,
			"y": 4227.270108953913,
			"width": 448.7890625,
			"height": 150,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
