			"frameId": null,
			"index": "bPw",
			"roundness": null,
			"seed": 925792586,
			"version": 326,
			"versionNonce": 1100329622,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1774743164081,
			"link": null,
			"locked": false,
			"text": "in e.g.1 starts at nums[0] and jumps 1 instead of 2 bc\nwe're trying to minimize the amount of jumps\nif we were to jump 2 instead:\n1. jump 2 steps from index 0 to 2\n2. jump 1 step from index 2 to 3\n3. jump 1 step from index 3 to 4\n\nit would have taken 3 jumps instead of 2",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "in e.g.1 starts at nums[0] and jumps 1 instead of 2 bc\nwe're trying to minimize the amount of jumps\nif we were to jump 2 instead:\n1. jump 2 steps from index 0 to 2\n2. jump 1 step from index 2 to 3\n3. jump 1 step from index 3 to 4\n\nit would have taken 3 jumps instead of 2",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
