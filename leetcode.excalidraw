			"version": 386,
			"versionNonce": 1761588782,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773547629770,
			"link": null,
			"locked": false,
			"text": "Given an integer array nums, move all 0's to the end of it while\nmaintaining the relative order of the non-zero elements.\n\nNote that you must do this in-place without making a copy of\nthe array.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Given an integer array nums, move all 0's to the end of it while\nmaintaining the relative order of the non-zero elements.\n\nNote that you must do this in-place without making a copy of\nthe array.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "qEK5C1eW",
