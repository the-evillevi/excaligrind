			"text": "l, r = 0, len(nums)-1\n\nleft = [1] * len(nums)\nright = [1] * len(nums)\n\nwhile l < len(nums) and r > -1:\n    left[l] = left[l - 1] * nums[l - 1] if l > 0 else left[l]\n    right[r] = right[r + 1] * nums[r + 1] if r < len(nums)-1 else right[r]\n\n    l += 1\n    r -= 1\n\noutput = []\nfor i in range(len(nums)):\n    output.append(left[i] * right[i])\n\nreturn output",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "l, r = 0, len(nums)-1\n\nleft = [1] * len(nums)\nright = [1] * len(nums)\n\nwhile l < len(nums) and r > -1:\n    left[l] = left[l - 1] * nums[l - 1] if l > 0 else left[l]\n    right[r] = right[r + 1] * nums[r + 1] if r < len(nums)-1 else right[r]\n\n    l += 1\n    r -= 1\n\noutput = []\nfor i in range(len(nums)):\n    output.append(left[i] * right[i])\n\nreturn output",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
