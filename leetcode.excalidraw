			"text": "beginWord = \"hit\",\nendWord = \"cog\",\nwordList = [\"hot\",\"dot\",\"dog\",\"lot\",\"log\",\"cog\"]\n\n---\n\nif endWord not in wordList:\n    return 0\n\nresult = 0\nqueue = dequeue([(beginWord, 1)])\nseen = set()\nresult = 0\n\nwhile queue:\n    cword, ccount = queue.pop()\n    \n    if cword == endWord:\n        result = ccount\n        break\n\n    if cword in seen:\n        continue\n\n    #compare cword with word in wordList:\n    for word in wordList:\n        if diff(cword, word) == 1:\n            queue.append((word, ccount + 1))\n\nreturn result\n\ndef diff():\n    pass\n        ",
			"rawText": "beginWord = \"hit\",\nendWord = \"cog\",\nwordList = [\"hot\",\"dot\",\"dog\",\"lot\",\"log\",\"cog\"]\n\n---\n\nif endWord not in wordList:\n    return 0\n\nresult = 0\nqueue = dequeue([(beginWord, 1)])\nseen = set()\nresult = 0\n\nwhile queue:\n    cword, ccount = queue.pop()\n    \n    if cword == endWord:\n        result = ccount\n        break\n\n    if cword in seen:\n        continue\n\n    #compare cword with word in wordList:\n    for word in wordList:\n        if diff(cword, word) == 1:\n            queue.append((word, ccount + 1))\n\nreturn result\n\ndef diff():\n    pass\n        ",
