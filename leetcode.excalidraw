		},
		{
			"id": "GWoQdPF0",
			"type": "text",
			"x": 4724.468739125369,
			"y": 1842.574095033218,
			"width": 351.30859375,
			"height": 425,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0W",
			"roundness": null,
			"seed": 2084010522,
			"version": 652,
			"versionNonce": 90445466,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772481093440,
			"link": null,
			"locked": false,
			"text": "def is_valid_grid(grid: List[List[int]]):\n        max_right = []\n        \n        for row in grid:\n            one_counter = 0\n            for cell in row:\n                # cells are either 0's or 1's\n                one_counter += cell\n            max_right.append(one_counter)\n\n        max_right.sort()\n\n        for i in range(len(grid)):\n            if max_right[i] > i:\n                return False\n\n        return True",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "def is_valid_grid(grid: List[List[int]]):\n        max_right = []\n        \n        for row in grid:\n            one_counter = 0\n            for cell in row:\n                # cells are either 0's or 1's\n                one_counter += cell\n            max_right.append(one_counter)\n\n        max_right.sort()\n\n        for i in range(len(grid)):\n            if max_right[i] > i:\n                return False\n\n        return True",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
