		{
			"id": "JCZV7rim",
			"type": "text",
			"x": 984.3006829473281,
			"y": 10565.719221849664,
			"width": 539.1796875,
			"height": 50,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "bDQ",
			"roundness": null,
			"seed": 608002866,
			"version": 162,
			"versionNonce": 1666166898,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773853322371,
			"link": null,
			"locked": false,
			"text": "constraint 3: 1 <= m, n <= 500 tells us the problem is actually\nlow-key small so we can do BFS.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "constraint 3: 1 <= m, n <= 500 tells us the problem is actually\nlow-key small so we can do BFS.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "Fry4u8ZQ",
			"type": "text",
			"x": 1049.9580547305366,
			"y": 11486.460985528225,
			"width": 609.9796142578125,
			"height": 1175,
			"angle": 0,
			"strokeColor": "#b2f2bb",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "bDe",
			"roundness": null,
			"seed": 623949998,
			"version": 2032,
			"versionNonce": 987974804,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1789073989927,
			"locked": false,
			"text": "from collections import deque\n\ndef numEnclaves(grid):\n    m, n = len(grid), len(grid[0])\n    queue = deque()\n    directions = [[0, 1], [1, 0], [0, -1], [-1, 0]] \n    reachable = set()\n\n    # Step 1: seed your queue with ALL boundary 1-cells\n    # YOUR CODE HERE\n    for row in range(m):\n        for col in range(n):\n            if (grid[row][col] == 1 and\n                (row == 0 or\n                row == m-1 or\n                col == 0 or\n                col == n-1)):\n                # this is a boundary adjacent cell\n                queue.append((row, col))\n                reachable.add((row, col))\n\n    \n    # Step 2: BFS — mark everything reachable\n    while queue:\n        row, col = queue.popleft()\n\n        for dr, dc in directions:\n            next_row = row + dr\n            next_col = col + dc\n            if (is_bounded(m, n, next_row, next_col)\n                and grid[next_row][next_col] == 1\n                and (next_row, next_col) not in reachable:\n                queue.append((next_row, next_col))\n    \n        reachable.add((row, col))\n    \n    # Step 3: count what's left\n    counter = 0\n    for row in range(m):\n        for col in range(n):\n            if grid[row][col] == 1 and (row, col) not in reachable:\n                counter += 1\n    return counter\n\ndef is_bounded(m, n, row, col):\n    if 0 <= row < m and 0 <= col < n:\n        return True",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "from collections import deque\n\ndef numEnclaves(grid):\n    m, n = len(grid), len(grid[0])\n    queue = deque()\n    directions = [[0, 1], [1, 0], [0, -1], [-1, 0]] \n    reachable = set()\n\n    # Step 1: seed your queue with ALL boundary 1-cells\n    # YOUR CODE HERE\n    for row in range(m):\n        for col in range(n):\n            if (grid[row][col] == 1 and\n                (row == 0 or\n                row == m-1 or\n                col == 0 or\n                col == n-1)):\n                # this is a boundary adjacent cell\n                queue.append((row, col))\n                reachable.add((row, col))\n\n    \n    # Step 2: BFS — mark everything reachable\n    while queue:\n        row, col = queue.popleft()\n\n        for dr, dc in directions:\n            next_row = row + dr\n            next_col = col + dc\n            if (is_bounded(m, n, next_row, next_col)\n                and grid[next_row][next_col] == 1\n                and (next_row, next_col) not in reachable:\n                queue.append((next_row, next_col))\n    \n        reachable.add((row, col))\n    \n    # Step 3: count what's left\n    counter = 0\n    for row in range(m):\n        for col in range(n):\n            if grid[row][col] == 1 and (row, col) not in reachable:\n                counter += 1\n    return counter\n\ndef is_bounded(m, n, row, col):\n    if 0 <= row < m and 0 <= col < n:\n        return True",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": "from collections import deque\n\ndef numEnclaves(grid):\n    m, n = len(grid), len(grid[0])\n    queue = deque()\n    directions = [[0, 1], [1, 0], [0, -1], [-1, 0]] \n    reachable = set()\n\n    # Step 1: seed your queue with ALL boundary 1-cells\n    # YOUR CODE HERE\n    for row in range(m):\n        for col in range(n):\n            if (grid[row][col] == 1 and\n                (row == 0 or\n                row == m-1 or\n                col == 0 or\n                col == n-1)):\n                # this is a boundary adjacent cell\n                queue.append((row, col))\n                reachable.add((row, col))\n\n    \n    # Step 2: BFS — mark everything reachable\n    while queue:\n        row, col = queue.popleft()\n\n        for dr, dc in directions:\n            next_row = row + dr\n            next_col = col + dc\n            if (is_bounded(m, n, next_row, next_col)\n                and grid[next_row][next_col] == 1\n                and (next_row, next_col) not in reachable:\n                queue.append((next_row, next_col))\n    \n        reachable.add((row, col))\n    \n    # Step 3: count what's left\n    counter = 0\n    for row in range(m):\n        for col in range(n):\n            if grid[row][col] == 1 and (row, col) not in reachable:\n                counter += 1\n    return counter\n\ndef is_bounded(m, n, row, col):\n    if 0 <= row < m and 0 <= col < n:\n        return True"
		},
