			"rawText": ""
		},
		{
			"id": "RZ27Er8I",
			"type": "text",
			"x": 101.48273671449977,
			"y": 15758.494416816717,
			"width": 469.150390625,
			"height": 200,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
