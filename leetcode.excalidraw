			"isDeleted": false,
			"boundElements": [],
			"updated": 1773628938068,
			"link": null,
			"locked": false,
			"text": "Given an integer array nums, find the subarray with the largest sum,\nand return its sum.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Given an integer array nums, find the subarray with the largest sum,\nand return its sum.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "dBz98iMp",
			"type": "text",
			"x": 6850.0788563406895,
			"y": 3890.36366240229,
			"width": 520.283203125,
			"height": 125,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b6x",
			"roundness": null,
			"seed": 2012120302,
			"version": 438,
			"versionNonce": 956313262,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773547629770,
			"link": null,
			"locked": false,
			"text": "Example 1:\n\nInput: nums = [-2,1,-3,4,-1,2,1,-5,4]\nOutput: 6\nExplanation: The subarray [4,-1,2,1] has the largest sum 6.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Example 1:\n\nInput: nums = [-2,1,-3,4,-1,2,1,-5,4]\nOutput: 6\nExplanation: The subarray [4,-1,2,1] has the largest sum 6.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "1SN2BBOa",
			"type": "text",
			"x": 6853.669461161731,
			"y": 4071.1941556984284,
			"width": 463.583984375,
			"height": 125,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b6y",
			"roundness": null,
			"seed": 1391434414,
			"version": 423,
			"versionNonce": 715270382,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773547629770,
			"link": null,
			"locked": false,
			"text": "Example 2:\n\nInput: nums = [1]\nOutput: 1\nExplanation: The subarray [1] has the largest sum 1.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Example 2:\n\nInput: nums = [1]\nOutput: 1\nExplanation: The subarray [1] has the largest sum 1.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "IAzlZ7j1",
			"type": "text",
			"x": 6857.331639500797,
			"y": 4265.528186062396,
			"width": 548.0859375,
			"height": 150,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b6z",
			"roundness": null,
			"seed": 24200878,
			"version": 382,
			"versionNonce": 42654510,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773547629770,
			"link": null,
			"locked": false,
			"text": "Example 3:\n\nInput: nums = [5,4,-1,7,8]\nOutput: 23\nExplanation: The subarray [5,4,-1,7,8] has the largest sum 23.\n",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Example 3:\n\nInput: nums = [5,4,-1,7,8]\nOutput: 23\nExplanation: The subarray [5,4,-1,7,8] has the largest sum 23.\n",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "u12j8zAV",
			"type": "text",
			"x": 6860.385442936626,
			"y": 4445.833806893001,
			"width": 222.392578125,
