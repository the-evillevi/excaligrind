		{
			"id": "Ve4Dsodn",
			"type": "text",
			"x": 2842.5984880433734,
			"y": 8631.123425086957,
			"width": 647.03125,
			"height": 625,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "bFa",
			"roundness": null,
			"seed": 149097966,
			"version": 38,
			"versionNonce": 308547762,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773973210357,
			"link": null,
			"locked": false,
			"text": "Given an array of strings words and a width maxWidth, format\nthe text such that each line has exactly maxWidth characters\nand is fully (left and right) justified.\n\nYou should pack your words in a greedy approach; that is, pack\nas many words as you can in each line. Pad extra spaces ' '\nwhen necessary so that each line has exactly maxWidth characters.\n\nExtra spaces between words should be distributed as evenly as possible.\nIf the number of spaces on a line does not divide evenly between\nwords, the empty slots on the left will be assigned more spaces\nthan the slots on the right.\n\nFor the last line of text, it should be left-justified, and no\nextra space is inserted between words.\n\nNote:\n\n- A word is defined as a character sequence consisting of non-space\ncharacters only.\n\n- Each word's length is guaranteed to be greater than 0 and not\nexceed maxWidth.\n\n- The input array words contains at least one word.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Given an array of strings words and a width maxWidth, format\nthe text such that each line has exactly maxWidth characters\nand is fully (left and right) justified.\n\nYou should pack your words in a greedy approach; that is, pack\nas many words as you can in each line. Pad extra spaces ' '\nwhen necessary so that each line has exactly maxWidth characters.\n\nExtra spaces between words should be distributed as evenly as possible.\nIf the number of spaces on a line does not divide evenly between\nwords, the empty slots on the left will be assigned more spaces\nthan the slots on the right.\n\nFor the last line of text, it should be left-justified, and no\nextra space is inserted between words.\n\nNote:\n\n- A word is defined as a character sequence consisting of non-space\ncharacters only.\n\n- Each word's length is guaranteed to be greater than 0 and not\nexceed maxWidth.\n\n- The input array words contains at least one word.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "Ks8tvFxK",
			"type": "text",
			"x": 2850.3864134004016,
			"y": 9292.210434726883,
			"width": 617.958984375,
			"height": 225,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "bFb",
			"roundness": null,
			"seed": 536304174,
			"version": 93,
			"versionNonce": 1109277806,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773973255058,
			"link": null,
			"locked": false,
			"text": "e.g. 1\nInput: words = [\"This\", \"is\", \"an\", \"example\", \"of\", \"text\", \"justification.\"],\nmaxWidth = 16\nOutput:\n[\n   \"This    is    an\",\n   \"example  of text\",\n   \"justification.  \"\n]",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "e.g. 1\nInput: words = [\"This\", \"is\", \"an\", \"example\", \"of\", \"text\", \"justification.\"],\nmaxWidth = 16\nOutput:\n[\n   \"This    is    an\",\n   \"example  of text\",\n   \"justification.  \"\n]",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "1otSwtJB",
			"type": "text",
