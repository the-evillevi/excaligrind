			"text": "Divide & Conquer with Index\nBounds (Arrays) Strategy",
			"fontSize": 36,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Divide & Conquer with Index\nBounds (Arrays) Strategy",
