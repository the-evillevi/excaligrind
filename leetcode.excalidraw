			"isDeleted": false,
			"boundElements": [],
			"updated": 1774574391135,
			"link": null,
			"locked": false,
			"text": "currentLine = \"\"\ncurrentLineWidth = 0\n\nwhile len(words) > 0:\n    currentLine = []\n    currentLineWidth = 0\n\n    while currentLineWidth < maxWidth:\n        word = get_next_word(words)\n        currentLine.append(word)\n        currentLine.append(\" \")\n        currentLineWidth = len(word+\" \")\n        \n        if currentLineWidth == maxWidth:\n            # best case scenario\n            continue\n        \n        elif currentLine  > maxWidth:\n            while currentLine > maxWidth:\n                # remove last space and word\n                # until currentLine is less than mw\n                del currentLine[-1]\n                return(currentLine[-2])\n                del currentLine[-2]\n                \n        \n# do this methods feel like a queue?\n\ndef get_next_word(words) -> str:\n    word = words[0]\n    del words[0]\n    return word\n\ndef return_word(words, word):\n    words.append(word)",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "currentLine = \"\"\ncurrentLineWidth = 0\n\nwhile len(words) > 0:\n    currentLine = []\n    currentLineWidth = 0\n\n    while currentLineWidth < maxWidth:\n        word = get_next_word(words)\n        currentLine.append(word)\n        currentLine.append(\" \")\n        currentLineWidth = len(word+\" \")\n        \n        if currentLineWidth == maxWidth:\n            # best case scenario\n            continue\n        \n        elif currentLine  > maxWidth:\n            while currentLine > maxWidth:\n                # remove last space and word\n                # until currentLine is less than mw\n                del currentLine[-1]\n                return(currentLine[-2])\n                del currentLine[-2]\n                \n        \n# do this methods feel like a queue?\n\ndef get_next_word(words) -> str:\n    word = words[0]\n    del words[0]\n    return word\n\ndef return_word(words, word):\n    words.append(word)",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
