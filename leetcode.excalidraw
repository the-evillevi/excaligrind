			"updated": 1772137813258,
			"link": null,
			"locked": false,
			"text": "prefix = \"\"\n\nfor i in range(len(strs[0])):\n    for s in strs:\n        if i == len(s) or s[i] != strs[0][i]:\n            return prefix\n        prefix += strs[0][i]\n        \nreturn prefix",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "prefix = \"\"\n\nfor i in range(len(strs[0])):\n    for s in strs:\n        if i == len(s) or s[i] != strs[0][i]:\n            return prefix\n        prefix += strs[0][i]\n        \nreturn prefix",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
