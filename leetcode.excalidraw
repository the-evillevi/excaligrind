			"locked": false,
			"text": "func merge(nums1 []int, m int, nums2 []int, n int)  {\n    last := m + n - 1\n    m--\n    n--\n\n    for m >= 0 && n >= 0 {\n        if nums1[m] > nums2[n] {\n            nums1[last] = nums1[m]\n            m--\n        } else {\n            nums1[last] = nums2[n]\n            n--\n        }\n        last--\n    }\n\n    for n >= 0 {\n        nums1[last] = nums2[n]\n        n--\n        last--\n    }\n}\n",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "func merge(nums1 []int, m int, nums2 []int, n int)  {\n    last := m + n - 1\n    m--\n    n--\n\n    for m >= 0 && n >= 0 {\n        if nums1[m] > nums2[n] {\n            nums1[last] = nums1[m]\n            m--\n        } else {\n            nums1[last] = nums2[n]\n            n--\n        }\n        last--\n    }\n\n    for n >= 0 {\n        nums1[last] = nums2[n]\n        n--\n        last--\n    }\n}\n",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
