		{
			"id": "jp5OptSI",
			"type": "text",
			"x": 1061.6046637865384,
			"y": 1142.0585191182306,
			"width": 635.322265625,
			"height": 275,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
