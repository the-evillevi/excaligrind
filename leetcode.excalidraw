			"updated": 1773628498842,
			"link": null,
			"locked": false,
			"text": "sum = 0\nmax_sum = nums[0]\nfor n in nums:\n    sum = max(sum, 0)\n    sum += n\n    max_sum = max(max_sum, sum)\nreturn max_sum",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "sum = 0\nmax_sum = nums[0]\nfor n in nums:\n    sum = max(sum, 0)\n    sum += n\n    max_sum = max(max_sum, sum)\nreturn max_sum",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
