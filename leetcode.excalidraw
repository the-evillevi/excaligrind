			"link": null,
			"locked": false,
			"text": "Given an array nums. We define a running sum of an array\nas runningSum[i] = sum(nums[0]…nums[i]).\n\nReturn the running sum of nums.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Given an array nums. We define a running sum of an array\nas runningSum[i] = sum(nums[0]…nums[i]).\n\nReturn the running sum of nums.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
