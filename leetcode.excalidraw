		{
			"id": "qv3z3yJG",
			"type": "text",
			"x": 4360.972873645529,
			"y": 2723.109684874768,
			"width": 409.58984375,
			"height": 650,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0d",
			"roundness": null,
			"seed": 302919130,
			"version": 3,
			"versionNonce": 946601818,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772483656140,
			"link": null,
			"locked": false,
			"text": "class Solution:\n    def minSwaps(self, grid: List[List[int]]) -> int:\n        n = len(grid)\n        pos = [-1] * n\n        for i in range(n):\n            for j in range(n - 1, -1, -1):\n                if grid[i][j] == 1:\n                    pos[i] = j\n                    break\n        \n        ans = 0\n        for i in range(n):\n            k = -1\n            for j in range(i, n):\n                if pos[j] <= i:\n                    ans += j - i\n                    k = j\n                    break\n            \n            if k != -1:\n                for j in range(k, i, -1):\n                    pos[j], pos[j - 1] = pos[j - 1], pos[j]\n            else:\n                return -1\n        \n        return ans",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "class Solution:\n    def minSwaps(self, grid: List[List[int]]) -> int:\n        n = len(grid)\n        pos = [-1] * n\n        for i in range(n):\n            for j in range(n - 1, -1, -1):\n                if grid[i][j] == 1:\n                    pos[i] = j\n                    break\n        \n        ans = 0\n        for i in range(n):\n            k = -1\n            for j in range(i, n):\n                if pos[j] <= i:\n                    ans += j - i\n                    k = j\n                    break\n            \n            if k != -1:\n                for j in range(k, i, -1):\n                    pos[j], pos[j - 1] = pos[j - 1], pos[j]\n            else:\n                return -1\n        \n        return ans",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
