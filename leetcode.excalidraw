			"link": null,
			"locked": false,
			"text": "output: [\n    [-2, -1, 1, 2],\n    [-2, 0, 0, 2],\n    [-1, 0, 0, 1],\n]\n\nhow was this output built?\n\noutput: [\n    [nums[4], nums[2], nums[1], nums[5]],\n    [nums[4], nums[1], nums[3], nums[5]],\n    [nums[2], nums[1], nums[3], nums[0]],\n]",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "output: [\n    [-2, -1, 1, 2],\n    [-2, 0, 0, 2],\n    [-1, 0, 0, 1],\n]\n\nhow was this output built?\n\noutput: [\n    [nums[4], nums[2], nums[1], nums[5]],\n    [nums[4], nums[1], nums[3], nums[5]],\n    [nums[2], nums[1], nums[3], nums[0]],\n]",
