			"link": null,
			"locked": false,
			"text": "seen = {}\nwhile True:\n    sum = 0\n    n_str = str(n)\n    \n    for digit in n_str:\n        sum += int(digit) ** 2\n\n    if sum in seen:\n        return False\n    else:\n        seen[sum] = True\n\n    n = sum\n\n    if sum == 1:\n        return True",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "seen = {}\nwhile True:\n    sum = 0\n    n_str = str(n)\n    \n    for digit in n_str:\n        sum += int(digit) ** 2\n\n    if sum in seen:\n        return False\n    else:\n        seen[sum] = True\n\n    n = sum\n\n    if sum == 1:\n        return True",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
