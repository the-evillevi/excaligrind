			"text": "Constraints:\n\n1 <= s.length <= 104\ns consists of parentheses only '()[]{}'.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Constraints:\n\n1 <= s.length <= 104\ns consists of parentheses only '()[]{}'.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "OGQxU9PC",
			"type": "text",
			"x": 2207.9220748372395,
			"y": 15155.403990911822,
			"width": 363.53515625,
			"height": 575,
			"angle": 0,
			"strokeColor": "#b2f2bb",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "bW8",
			"roundness": null,
			"seed": 1585474876,
			"version": 106,
			"versionNonce": 342289796,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778645885752,
			"link": null,
			"locked": false,
			"text": "class Solution:\n    def isValid(self, s: str) -> bool:\n        stack = []\n        for c in s:\n            if c == \"(\" or c == \"{\" or c == \"[\":\n                stack.append(c)\n            else:\n                if len(stack) == 0:\n                    return False\n\n                prev_c = stack.pop()\n                if (prev_c == \"(\" and c != \")\"\n                    or prev_c == \"{\" and c != \"}\"\n                    or prev_c == \"[\" and c != \"]\"):\n                    return False\n\n        if len(stack) == 0:\n            return True\n        \n        return False\n\n            \n        ",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "class Solution:\n    def isValid(self, s: str) -> bool:\n        stack = []\n        for c in s:\n            if c == \"(\" or c == \"{\" or c == \"[\":\n                stack.append(c)\n            else:\n                if len(stack) == 0:\n                    return False\n\n                prev_c = stack.pop()\n                if (prev_c == \"(\" and c != \")\"\n                    or prev_c == \"{\" and c != \"}\"\n                    or prev_c == \"[\" and c != \"]\"):\n                    return False\n\n        if len(stack) == 0:\n            return True\n        \n        return False\n\n            \n        ",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
