			"updated": 1774743053578,
			"link": null,
			"locked": false,
			"text": "always start at nums[0]\ncan jump up to nums[i] (from 0 to 2 at nums[0]==2)\n",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "always start at nums[0]\ncan jump up to nums[i] (from 0 to 2 at nums[0]==2)\n",
