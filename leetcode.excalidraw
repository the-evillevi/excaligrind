			"text": "class Solution:\n    def fullJustify(self, words: List[str], maxWidth: int) -> List[str]:\n        lines = [] # list of word groups\n        current_line = []\n        current_width = 0\n\n        # step 1: group words into lines\n        for word in words:\n            # does this word fit on the current line?\n            if current_width + len(word) + len(current_line) <= maxWidth:\n                current_line.append(word)\n                current_width += len(word)\n            else:\n                lines.append(current_line)\n                current_line = [word]\n                current_width = len(word)\n\n        lines.append(current_line)\n\n        # step 2: justify each line\n        result = []\n        for i, line in enumerate(lines):\n            # is it the last line?\n            if i == len(lines) - 1:\n                total_chars = sum(len(w) for w in line)\n                gaps = len(line) - 1\n                spaces = maxWidth - total_chars - gaps\n\n                print(\"last line\")\n                print(f\"\\tline={line} \\ttotal_chars={total_chars} \\tgaps={gaps} \\tspaces={spaces}\")\n\n                justified_line = \"\"\n                for i, word in enumerate(line):\n                    if i == len(line) - 1:\n                        justified_line += word + spaces*\" \"\n                    else:\n                        justified_line += word + \" \"\n                result.append(justified_line)\n\n            # is it a single word?\n            elif len(line) == 1:\n                word = line[0]\n                spaces = maxWidth - len(word)\n\n                print(\"single word\")\n                print(f\"\\tline={line} \\tspaces={spaces}\")\n\n                result.append(word + spaces*\" \")\n                continue\n\n            # general case\n            else:\n                total_chars = sum(len(w) for w in line)\n                gaps = len(line) - 1\n                extra_spaces = maxWidth - total_chars\n                min_spaces = extra_spaces // gaps\n                leftover = extra_spaces % gaps\n\n                print(\"general case\")\n                print(f\"\\tline={line}\\ttotal_chars={total_chars} \\tgaps={gaps} \\textra_spaces={extra_spaces} \\tmin_spaces={min_spaces} \\tleftover={leftover}\")\n\n                justified_line = \"\"\n                for i, word in enumerate(line):\n                    if leftover > 0:\n                        justified_line += word + min_spaces*\" \" + \" \"\n                        leftover -= 1\n                    elif i == len(line) - 1:\n                        justified_line += word\n                    else:\n                        justified_line += word + min_spaces*\" \"\n\n\n                result.append(justified_line)\n        \n        return result",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "class Solution:\n    def fullJustify(self, words: List[str], maxWidth: int) -> List[str]:\n        lines = [] # list of word groups\n        current_line = []\n        current_width = 0\n\n        # step 1: group words into lines\n        for word in words:\n            # does this word fit on the current line?\n            if current_width + len(word) + len(current_line) <= maxWidth:\n                current_line.append(word)\n                current_width += len(word)\n            else:\n                lines.append(current_line)\n                current_line = [word]\n                current_width = len(word)\n\n        lines.append(current_line)\n\n        # step 2: justify each line\n        result = []\n        for i, line in enumerate(lines):\n            # is it the last line?\n            if i == len(lines) - 1:\n                total_chars = sum(len(w) for w in line)\n                gaps = len(line) - 1\n                spaces = maxWidth - total_chars - gaps\n\n                print(\"last line\")\n                print(f\"\\tline={line} \\ttotal_chars={total_chars} \\tgaps={gaps} \\tspaces={spaces}\")\n\n                justified_line = \"\"\n                for i, word in enumerate(line):\n                    if i == len(line) - 1:\n                        justified_line += word + spaces*\" \"\n                    else:\n                        justified_line += word + \" \"\n                result.append(justified_line)\n\n            # is it a single word?\n            elif len(line) == 1:\n                word = line[0]\n                spaces = maxWidth - len(word)\n\n                print(\"single word\")\n                print(f\"\\tline={line} \\tspaces={spaces}\")\n\n                result.append(word + spaces*\" \")\n                continue\n\n            # general case\n            else:\n                total_chars = sum(len(w) for w in line)\n                gaps = len(line) - 1\n                extra_spaces = maxWidth - total_chars\n                min_spaces = extra_spaces // gaps\n                leftover = extra_spaces % gaps\n\n                print(\"general case\")\n                print(f\"\\tline={line}\\ttotal_chars={total_chars} \\tgaps={gaps} \\textra_spaces={extra_spaces} \\tmin_spaces={min_spaces} \\tleftover={leftover}\")\n\n                justified_line = \"\"\n                for i, word in enumerate(line):\n                    if leftover > 0:\n                        justified_line += word + min_spaces*\" \" + \" \"\n                        leftover -= 1\n                    elif i == len(line) - 1:\n                        justified_line += word\n                    else:\n                        justified_line += word + min_spaces*\" \"\n\n\n                result.append(justified_line)\n        \n        return result",
