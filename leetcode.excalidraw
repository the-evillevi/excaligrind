			"seed": 239473405,
			"version": 165,
			"versionNonce": 949449878,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1774574391135,
			"link": null,
			"locked": false,
			"text": "step 1: group words into lines\n- walk through words one by one \n- a word fits on the current line if:\n    - current_width +\n    - len(word) +\n    - len(current_line) <- accounts for spaces between existing words\n- if it does not fit, start a new one",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "step 1: group words into lines\n- walk through words one by one \n- a word fits on the current line if:\n    - current_width +\n    - len(word) +\n    - len(current_line) <- accounts for spaces between existing words\n- if it does not fit, start a new one",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "56RLCe28",
			"type": "text",
			"x": 3772.8882911019136,
			"y": 10652.207293100559,
			"width": 434.677734375,
			"height": 50,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
