			"isDeleted": false,
			"boundElements": [],
			"updated": 1772135607085,
			"link": null,
			"locked": false,
			"text": "prefix = \"\"\nstr_idx = 0\nprefix_idx = 0\n\n# iterate words and substrings\nwhile common_prefix_exists:\n    s = strs[str_idx]\n\n    if str_idx == 0:\n        prefix += s[prefix_idx]\n    elif str_idx == len(strs) - 1:\n        prefix_idx += 1\n\n    if prefix_idx < len(s) and s[prefix_idx] == prefix[prefix_idx]:\n        common_prefix_exists = True\n    else:\n        common_prefix_exists = False\n        continue\n\n    str_idx += 1 % len(strs)\n\nreturn prefix",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "prefix = \"\"\nstr_idx = 0\nprefix_idx = 0\n\n# iterate words and substrings\nwhile common_prefix_exists:\n    s = strs[str_idx]\n\n    if str_idx == 0:\n        prefix += s[prefix_idx]\n    elif str_idx == len(strs) - 1:\n        prefix_idx += 1\n\n    if prefix_idx < len(s) and s[prefix_idx] == prefix[prefix_idx]:\n        common_prefix_exists = True\n    else:\n        common_prefix_exists = False\n        continue\n\n    str_idx += 1 % len(strs)\n\nreturn prefix",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
