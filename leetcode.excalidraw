		{
			"id": "IghHm0tU",
			"type": "text",
			"x": -5.976974750271026,
			"y": 14472.52050708997,
			"width": 582.568359375,
			"height": 300,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "bPe",
