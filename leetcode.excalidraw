			"text": "how to move clockwise? \nface east, move 1: [2,5], [2,6]\nface south, move 1: [3,6]\nface west, move 2: [3,5], [3,4]\nface north, move 2: [2,4], [1,4]\nface east, move 2: [1,5], [1,6]\nface south, can't move, jump 3: [4,6]\n    this jump does not use the extra \"virtual\" cells I added,\n    so they might not be necessary\nface east, move 3: [4,5], [4,4], [4,3]\nface north, move 3: [3,3], [2,3], [1,3]\n",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "how to move clockwise? \nface east, move 1: [2,5], [2,6]\nface south, move 1: [3,6]\nface west, move 2: [3,5], [3,4]\nface north, move 2: [2,4], [1,4]\nface east, move 2: [1,5], [1,6]\nface south, can't move, jump 3: [4,6]\n    this jump does not use the extra \"virtual\" cells I added,\n    so they might not be necessary\nface east, move 3: [4,5], [4,4], [4,3]\nface north, move 3: [3,3], [2,3], [1,3]\n",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
