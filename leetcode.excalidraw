			"updated": 1773256455308,
			"link": null,
			"locked": false,
			"text": "the *complement* of an integer is the integer you get when you flip all the\n`0`s to `1`s and all the `1`s to `0`s in its binary representation.\n\ngiven an integer `n` return its complement.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "the *complement* of an integer is the integer you get when you flip all the\n`0`s to `1`s and all the `1`s to `0`s in its binary representation.\n\ngiven an integer `n` return its complement.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
