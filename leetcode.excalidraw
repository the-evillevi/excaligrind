		{
			"id": "PcEk7mCW",
			"type": "text",
			"x": 4214.31956185912,
			"y": 5562.558012500064,
			"width": 326.826171875,
			"height": 150,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
