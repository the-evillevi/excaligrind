		{
			"id": "tph2E0qs",
			"type": "text",
			"x": 42.095650397674035,
			"y": -1223.675154184272,
			"width": 501.337890625,
			"height": 375,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [
				"pBBh8cdB8VRYGyuI3GBi_"
			],
			"frameId": null,
			"index": "b7C",
			"roundness": null,
			"seed": 2094001906,
			"version": 903,
			"versionNonce": 843615794,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773547646566,
			"link": null,
			"locked": false,
			"text": "initialize left = 0\ninitialize window_state (sum, count, frequency map, etc.)\ninitialize min_or_max_result\n\nfor right from 0 to arr.length - 1:\n    # expand the window\n    update window_state to include arr[rigth]\n\n    while window_state violates the condition:\n        update min_or_max_result (if needed)\n        # shrink the window\n        update window_state to exclude arr[left]\n        move left pointer forward\n\nreturn min_or_max_result",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "initialize left = 0\ninitialize window_state (sum, count, frequency map, etc.)\ninitialize min_or_max_result\n\nfor right from 0 to arr.length - 1:\n    # expand the window\n    update window_state to include arr[rigth]\n\n    while window_state violates the condition:\n        update min_or_max_result (if needed)\n        # shrink the window\n        update window_state to exclude arr[left]\n        move left pointer forward\n\nreturn min_or_max_result",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
