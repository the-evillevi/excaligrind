			"updated": 1774574373089,
			"link": null,
			"locked": false,
			"text": "Given an unsorted array of integers nums, return the length\nof the longest consecutive elements sequence.\n\nYou must write an algorithm that runs in O(n) time.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Given an unsorted array of integers nums, return the length\nof the longest consecutive elements sequence.\n\nYou must write an algorithm that runs in O(n) time.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "LYklihjx",
			"type": "text",
			"x": 6787.307629107498,
			"y": 8811.75135305081,
