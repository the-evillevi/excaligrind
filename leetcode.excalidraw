			"isDeleted": false,
			"boundElements": [],
			"updated": 1774744865692,
			"link": null,
			"locked": false,
			"text": "# brute force solution:\n# iterate array\nmin_jumps = float(\"inf\")\nfor idx1, num in enumerate(nums):\n    # attempt every jump size for this n\n    for jump_size in range(n):\n        idx2 = idx1 + jump_size\n\ndef jump(nums, idx1, counter=0):\n    for jump_size in range(nums[idx1]):\n        idx2 = idx1 + jump_size\n        counter += 1\n        if idx2 > len(nums):\n            counter -= 1\n            continue\n        elif idx2 == len(nums):\n            return counter\n        else:\n            jump(nums, idx2, conter)",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "# brute force solution:\n# iterate array\nmin_jumps = float(\"inf\")\nfor idx1, num in enumerate(nums):\n    # attempt every jump size for this n\n    for jump_size in range(n):\n        idx2 = idx1 + jump_size\n\ndef jump(nums, idx1, counter=0):\n    for jump_size in range(nums[idx1]):\n        idx2 = idx1 + jump_size\n        counter += 1\n        if idx2 > len(nums):\n            counter -= 1\n            continue\n        elif idx2 == len(nums):\n            return counter\n        else:\n            jump(nums, idx2, conter)",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
