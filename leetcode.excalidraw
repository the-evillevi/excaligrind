			"seed": 1674350524,
			"version": 509,
			"versionNonce": 39274756,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778644439016,
			"link": null,
			"locked": false,
			"text": "given an array A of n elements with sorted values, and a \ntarget T\n\nfunction binary_search(A, n, T) is\n    L := 0\n    R := n − 1\n    while L ≤ R do\n        m := L + floor((R - L) / 2)\n        if A[m] < T then\n            L := m + 1\n        else if A[m] > T then\n            R := m − 1\n        else:\n            return m\n    return unsuccessful",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "given an array A of n elements with sorted values, and a \ntarget T\n\nfunction binary_search(A, n, T) is\n    L := 0\n    R := n − 1\n    while L ≤ R do\n        m := L + floor((R - L) / 2)\n        if A[m] < T then\n            L := m + 1\n        else if A[m] > T then\n            R := m − 1\n        else:\n            return m\n    return unsuccessful",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
