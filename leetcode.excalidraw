		{
			"id": "MUab2Hn4",
			"type": "text",
			"x": 1269.144620357728,
			"y": 15872.562339900129,
			"width": 495.1953125,
			"height": 525,
			"angle": 0,
			"strokeColor": "#b2f2bb",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "bVv",
			"roundness": null,
			"seed": 345869628,
			"version": 5,
			"versionNonce": 1663668868,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1778645117957,
			"link": null,
			"locked": false,
			"text": "class Solution:\n    def searchInsert(self, nums: List[int], target: int) -> int:\n        left = 0\n        right = len(nums) - 1\n        mid: int\n\n        while left <= right:\n            mid = left + (right - left) // 2\n\n            if nums[mid] < target:\n                left = mid + 1\n            elif nums[mid] > target:\n                right = mid - 1\n            else:\n                return mid\n        \n        # if not return in loop, target was not found\n        # return left, as it's the lesser/leftmost number\n        # where target would be if sort inserted\n        return left\n",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "class Solution:\n    def searchInsert(self, nums: List[int], target: int) -> int:\n        left = 0\n        right = len(nums) - 1\n        mid: int\n\n        while left <= right:\n            mid = left + (right - left) // 2\n\n            if nums[mid] < target:\n                left = mid + 1\n            elif nums[mid] > target:\n                right = mid - 1\n            else:\n                return mid\n        \n        # if not return in loop, target was not found\n        # return left, as it's the lesser/leftmost number\n        # where target would be if sort inserted\n        return left\n",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
