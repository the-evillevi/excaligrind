			"seed": 422301806,
			"version": 484,
			"versionNonce": 1889096046,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773547629770,
			"link": null,
			"locked": false,
			"text": "if nums[idx1] + nums[idx2] > target:\n    idx2 -= 1\nelif nums[idx1] + nums[idx2] < target:\n    idx1 += 1\nelse:\n    return[idx1, idx2]",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "if nums[idx1] + nums[idx2] > target:\n    idx2 -= 1\nelif nums[idx1] + nums[idx2] < target:\n    idx1 += 1\nelse:\n    return[idx1, idx2]",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
