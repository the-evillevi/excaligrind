			"link": null,
			"locked": false,
			"text": "output = [1] * len(nums)\n\nfor i in range(1, len(nums)):\n    output[i] = output[i-1] * nums[i-1]\n\nright = 1\nfor i in range(len(nums)-1, -1, -1):\n    output[i] *= right\n    right *= nums[i]\n\nreturn output",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "output = [1] * len(nums)\n\nfor i in range(1, len(nums)):\n    output[i] = output[i-1] * nums[i-1]\n\nright = 1\nfor i in range(len(nums)-1, -1, -1):\n    output[i] *= right\n    right *= nums[i]\n\nreturn output",
			"autoResize": true,
			"lineHeight": 1.25,
