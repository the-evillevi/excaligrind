		{
			"id": "TcI7Q8Vy",
			"type": "text",
			"x": 11385.386982241198,
			"y": 11857.028333707625,
			"width": 513.623046875,
			"height": 175,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [
				"doarVV5kc3dAW2fg89GYz"
			],
			"frameId": null,
			"index": "bPM",
			"roundness": null,
			"seed": 869034582,
			"version": 238,
			"versionNonce": 16173386,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1774666613790,
			"link": null,
			"locked": false,
			"text": "1. Divide the unsorted array into two sub-arrays,\nhalf the size of the original.\n2. Continue to divide the sub-arrays as long as the current\npiece of the array has more than one element.\n3. Merge two sub-arrays together by always putting the\nlowest value first.\n4. Keep merging until there are no sub-arrays left.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "1. Divide the unsorted array into two sub-arrays,\nhalf the size of the original.\n2. Continue to divide the sub-arrays as long as the current\npiece of the array has more than one element.\n3. Merge two sub-arrays together by always putting the\nlowest value first.\n4. Keep merging until there are no sub-arrays left.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
