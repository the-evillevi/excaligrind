		},
		{
			"id": "GAqh1TIX",
			"type": "text",
			"x": 16533.058059062365,
			"y": 303.9646030072845,
			"width": 626.839599609375,
			"height": 575,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [
				"Nv9pGwhlKhprGQLdXmb8t",
				"gBbAUi-y-aEo0tXLTbX0e"
			],
			"frameId": null,
			"index": "bWD1",
			"roundness": null,
			"seed": 1628566332,
			"version": 911,
			"versionNonce": 1958088577,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1779157524717,
			"link": null,
			"locked": false,
			"text": "- for internal use only\n- metrics\n    - op sys metrics\n        - cpu load\n        - mem usage\n        - disk space consumption\n    - RPS\n    - not business metrics\n- 100M daily active users, 1k server pools, 100 machines per pool\n    - 100 metrics per machine -> ~10 millions metrics\n- metrics data resolution\n    - raw data for 7 days\n    - after that, 1 minute resolution for 30 days\n    - after that, 1 hour resolution for 1 year\n    - 1 year data retention\n- alert channels\n    - email\n    - phone\n    - PagerDuty\n    - HTTP endpoints\n- no log collections (e.g. error, access)\n- no distributed syst. tracing\n",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "- for internal use only\n- metrics\n    - op sys metrics\n        - cpu load\n        - mem usage\n        - disk space consumption\n    - RPS\n    - not business metrics\n- 100M daily active users, 1k server pools, 100 machines per pool\n    - 100 metrics per machine -> ~10 millions metrics\n- metrics data resolution\n    - raw data for 7 days\n    - after that, 1 minute resolution for 30 days\n    - after that, 1 hour resolution for 1 year\n    - 1 year data retention\n- alert channels\n    - email\n    - phone\n    - PagerDuty\n    - HTTP endpoints\n- no log collections (e.g. error, access)\n- no distributed syst. tracing\n",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "8e4SeCY7",
