			"link": null,
			"locked": false,
			"text": "Example 1:\n\nInput: nums = [1,0,-1,0,-2,2], target = 0\nOutput: [[-2,-1,1,2],[-2,0,0,2],[-1,0,0,1]]",
			"fontSize": 20,
