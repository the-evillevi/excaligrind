			"updated": 1772069570708,
			"link": null,
			"locked": false,
			"text": "prices[i] is the price of a given stock on the ith day\nmaximize profit by choosing a single day to but one stock\nand choosing a different day in the future to sell that stock\n\nreturn the max profit you can achieve from this transaction\nif no profit is possible, return 0\n",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "prices[i] is the price of a given stock on the ith day\nmaximize profit by choosing a single day to but one stock\nand choosing a different day in the future to sell that stock\n\nreturn the max profit you can achieve from this transaction\nif no profit is possible, return 0\n",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
