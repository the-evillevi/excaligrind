			"link": null,
			"locked": false,
			"text": "approach 1: \n- transform decimal to binary\n- flip bits\n- transform binary to decimal\n\nis there a way to flip while transforming? ",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
