		{
			"id": "A573NhdE",
			"type": "text",
			"x": 11423.672889810456,
			"y": 11406.827263411838,
			"width": 375.72265625,
			"height": 275,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [
				"OiD4HDlZVwQf3CmyQ7BgW"
			],
			"frameId": null,
			"index": "bPW",
			"roundness": null,
			"seed": 1250362762,
			"version": 2270,
			"versionNonce": 689577290,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1774665926785,
			"link": null,
			"locked": false,
			"text": "def solve(arr, lo, hi):\n    # BASE CASE: single element or empty\n    if lo >= hi:\n        return base_value\n\n    mid = lo + (hi - lo) // 2 # avoid overflow\n\n    left = solve(arr, lo, mid)\n    right = solve(arr, mid + 1, hi)\n\n    return combine(left, right)",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "def solve(arr, lo, hi):\n    # BASE CASE: single element or empty\n    if lo >= hi:\n        return base_value\n\n    mid = lo + (hi - lo) // 2 # avoid overflow\n\n    left = solve(arr, lo, mid)\n    right = solve(arr, mid + 1, hi)\n\n    return combine(left, right)",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "tn1N2Km5HAJG7jPaw53CY",
			"type": "rectangle",
			"x": 11367.312534349328,
			"y": 11233.54085266145,
			"width": 570.2735217398995,
			"height": 486.5830026265805,
			"angle": 0,
