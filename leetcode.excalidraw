			"updated": 1774574373089,
			"link": null,
			"locked": false,
			"text": "approach 2: recursive k_sum",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "approach 2: recursive k_sum",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "wTPBsI1E",
			"type": "text",
			"x": 8712.98149095118,
			"y": 10957.224105194875,
			"width": 549.091796875,
			"height": 1050,
			"angle": 0,
			"strokeColor": "#b2f2bb",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "bNZ",
			"roundness": null,
			"seed": 1206166794,
			"version": 633,
			"versionNonce": 94363658,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1774574373089,
			"link": null,
			"locked": false,
			"text": "class Solution:\n    def fourSum(self, nums: List[int], target: int) -> List[List[int]]:\n        nums.sort()\n\n        def k_sum(k, arr, target):\n            if k < 2:\n                return []\n            if k == 2:\n                left = 0\n                right = len(arr) - 1\n                sol = []\n                while left < right:\n                    if left > 0 and arr[left] == arr[left - 1]:\n                        left += 1\n                        continue\n\n                    if right < len(arr) - 1 and arr[right] == arr[right + 1]:\n                        right -= 1\n                        continue\n\n                    if arr[left] + arr[right] > target:\n                        right -= 1\n                    elif arr[left] + arr[right] < target:\n                        left += 1\n                    else:\n                        sol.append([arr[left], arr[right]])\n                        left += 1\n                        right -= 1\n                return sol\n\n            output = []\n            for i, n in enumerate(arr):\n                if i > 0 and n == arr[i - 1]:\n                    continue\n                t = target - n\n                for subset in k_sum(k - 1, arr[i + 1 :], t):\n                    output.append([n] + subset)\n\n            return output\n\n        return k_sum(4, nums, target)\n",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "class Solution:\n    def fourSum(self, nums: List[int], target: int) -> List[List[int]]:\n        nums.sort()\n\n        def k_sum(k, arr, target):\n            if k < 2:\n                return []\n            if k == 2:\n                left = 0\n                right = len(arr) - 1\n                sol = []\n                while left < right:\n                    if left > 0 and arr[left] == arr[left - 1]:\n                        left += 1\n                        continue\n\n                    if right < len(arr) - 1 and arr[right] == arr[right + 1]:\n                        right -= 1\n                        continue\n\n                    if arr[left] + arr[right] > target:\n                        right -= 1\n                    elif arr[left] + arr[right] < target:\n                        left += 1\n                    else:\n                        sol.append([arr[left], arr[right]])\n                        left += 1\n                        right -= 1\n                return sol\n\n            output = []\n            for i, n in enumerate(arr):\n                if i > 0 and n == arr[i - 1]:\n                    continue\n                t = target - n\n                for subset in k_sum(k - 1, arr[i + 1 :], t):\n                    output.append([n] + subset)\n\n            return output\n\n        return k_sum(4, nums, target)\n",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
