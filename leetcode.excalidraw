			"updated": 1773869341193,
			"link": null,
			"locked": false,
			"text": "brute force is O(n**2):\n\noutput = [1] * len(nums)\nfor i in range(len(nums)):\n    for j in range(len(nums)):\n        if i != j:\n            output[i] *= nums[j]",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "brute force is O(n**2):\n\noutput = [1] * len(nums)\nfor i in range(len(nums)):\n    for j in range(len(nums)):\n        if i != j:\n            output[i] *= nums[j]",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
