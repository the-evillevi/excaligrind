			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "4tBBV5yk",
			"type": "text",
			"x": 5564.244037743311,
			"y": 1219.2704708913689,
			"width": 260.166015625,
			"height": 350,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0r",
			"roundness": null,
			"seed": 1245982670,
			"version": 461,
			"versionNonce": 1850640974,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772733718906,
			"link": null,
			"locked": false,
			"text": "        if len(s) == 1:\n            return 0\n\n        non_alt_count = 0\n        i = 1\n\n        while i < len(s):\n            if s[i - 1] == s[i]:\n                non_alt_count += 1\n                i += 1\n            i += 1\n\n        return non_alt_count\n        ",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "        if len(s) == 1:\n            return 0\n\n        non_alt_count = 0\n        i = 1\n\n        while i < len(s):\n            if s[i - 1] == s[i]:\n                non_alt_count += 1\n                i += 1\n            i += 1\n\n        return non_alt_count\n        ",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
