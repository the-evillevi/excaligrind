			"containerId": null,
			"originalText": "Example 1:\n\nInput: nums = [100,4,200,1,3,2]\nOutput: 4\nExplanation: The longest consecutive elements sequence is \n[1, 2, 3, 4]. Therefore its length is 4.",
			"autoResize": true,
