			"updated": 1773626638500,
			"link": null,
			"locked": false,
			"text": "for right in range(1, en(nums)):\n    sum += nums[right]\n\n    while sum < max_sum and left < right:\n        max_sum = sum\n        sum -= nums[left]\n        left += 1\n\nreturn max_sum",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "for right in range(1, en(nums)):\n    sum += nums[right]\n\n    while sum < max_sum and left < right:\n        max_sum = sum\n        sum -= nums[left]\n        left += 1\n\nreturn max_sum",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
