			"seed": 1084523762,
			"version": 362,
			"versionNonce": 1009762030,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773776888567,
			"link": null,
			"locked": false,
			"text": "# Return an array of coordinates\n# representing the positions of\n# the grid in the order you\n# visited them.\n\n[\n    [1, 4],\n    [1, 5],\n    [2, 5],\n    [2, 4],\n    [2, 3],\n    [1, 3],\n    [0, 3],\n    [0, 4],\n    [0, 5],\n    [3, 5],\n    [3, 4],\n    #...\n]",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "# Return an array of coordinates\n# representing the positions of\n# the grid in the order you\n# visited them.\n\n[\n    [1, 4],\n    [1, 5],\n    [2, 5],\n    [2, 4],\n    [2, 3],\n    [1, 3],\n    [0, 3],\n    [0, 4],\n    [0, 5],\n    [3, 5],\n    [3, 4],\n    #...\n]",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "IHS1yBL2",
			"type": "text",
			"x": 5.486089701662962,
			"y": 12050.041050959439,
			"width": 525.556640625,
			"height": 300,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "bB4",
			"roundness": null,
			"seed": 954318254,
			"version": 535,
			"versionNonce": 351017838,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1773778413713,
			"link": null,
			"locked": false,
			"text": "how to move clockwise? \nface east, move 1: [1,4], [1,5]\nface south, move 1: [2,5]\nface west, move 2: [2,4], [2,3]\nface north, move 2: [1,3], [0,3]\nface east, move 2: [0,4], [0,5]\nface south, can't move, jump 3: [3,5]\nface east, move 3: [3,4], [3,3], [3,2]\nface north, move 3: [2,2], [1,2], [0,2]\nface west, can't move, jump 3:\n    how do we jump this one tho? \n    might be better to create extra \"virtual\" space for jumping",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "how to move clockwise? \nface east, move 1: [1,4], [1,5]\nface south, move 1: [2,5]\nface west, move 2: [2,4], [2,3]\nface north, move 2: [1,3], [0,3]\nface east, move 2: [0,4], [0,5]\nface south, can't move, jump 3: [3,5]\nface east, move 3: [3,4], [3,3], [3,2]\nface north, move 3: [2,2], [1,2], [0,2]\nface west, can't move, jump 3:\n    how do we jump this one tho? \n    might be better to create extra \"virtual\" space for jumping",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
