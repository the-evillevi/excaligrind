			"isDeleted": false,
			"boundElements": [],
			"updated": 1773547629770,
			"link": null,
			"locked": false,
			"text": "e.g. 3\n\nInput: nums = [0,0,0,1,1,1,1,1,2,2,3,3,3]\nOutput: 8, nums = [0,0,1,1,2,2,3,3,_,_,_,_,_]",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "e.g. 3\n\nInput: nums = [0,0,0,1,1,1,1,1,2,2,3,3,3]\nOutput: 8, nums = [0,0,1,1,2,2,3,3,_,_,_,_,_]",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
