		{
			"id": "zmXTbdCM",
			"type": "text",
			"x": 6562.407841802123,
			"y": 1025.208132089967,
			"width": 366.2890625,
			"height": 300,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b1D",
			"roundness": null,
			"seed": 1273256462,
			"version": 153,
			"versionNonce": 1843056146,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772817353086,
			"link": null,
			"locked": false,
			"text": "is_first_segment_of_ones = True\nfor bit in s:\n    if is_first_segment_of_ones:\n        if bit == \"1\":\n            continue\n        else:\n            is_first_segment_of_ones = False\n    else:\n        if bit == \"1\":\n            return False\n        \nreturn True",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "is_first_segment_of_ones = True\nfor bit in s:\n    if is_first_segment_of_ones:\n        if bit == \"1\":\n            continue\n        else:\n            is_first_segment_of_ones = False\n    else:\n        if bit == \"1\":\n            return False\n        \nreturn True",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
