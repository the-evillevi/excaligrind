			"isDeleted": false,
			"boundElements": [],
			"updated": 1774574373089,
			"link": null,
			"locked": false,
			"text": "approach 1: sort first?\n\n1. nums.sort()\n2. max seq len = 0\n3. current seq len = 0\n4. start at nums[1]\n5. loop\n6. if nums[i] == nums[i - 1] + 1\n    6.1. increment csl\n    6.1. if csl > msl, update msl\n     ",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "approach 1: sort first?\n\n1. nums.sort()\n2. max seq len = 0\n3. current seq len = 0\n4. start at nums[1]\n5. loop\n6. if nums[i] == nums[i - 1] + 1\n    6.1. increment csl\n    6.1. if csl > msl, update msl\n     ",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
