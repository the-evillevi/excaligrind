		{
			"id": "uDpWJ4OV",
			"type": "text",
			"x": 17242.59520102808,
			"y": 306.01023994531215,
			"width": 791.2393798828125,
			"height": 225,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [
				"DXVP5RlbhYv0ZkkZgDeRr",
				"gBbAUi-y-aEo0tXLTbX0e"
			],
			"frameId": null,
			"index": "bWD3",
			"roundness": null,
			"seed": 406942140,
			"version": 941,
			"versionNonce": 1317462849,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1779157524717,
			"link": null,
			"locked": false,
			"text": "- scalability: syst. should accomodate growing metrics and alert volume\n- low latency: dashboards and alert should refflect real time as much as possible\n- reliability: avoid missing critical alerts\n- flexibility: pipeline should accomodate changing tech\n\nout of scope:\n- log collection/monitoring. ELK stack is popular for this\n- dist. syst. tracing: following a request across many services, let's you see what\n    happened and where",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "- scalability: syst. should accomodate growing metrics and alert volume\n- low latency: dashboards and alert should refflect real time as much as possible\n- reliability: avoid missing critical alerts\n- flexibility: pipeline should accomodate changing tech\n\nout of scope:\n- log collection/monitoring. ELK stack is popular for this\n- dist. syst. tracing: following a request across many services, let's you see what\n    happened and where",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
