			"frameId": null,
			"index": "ad",
			"roundness": null,
			"seed": 1724717213,
			"version": 260,
			"versionNonce": 180547133,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772133273016,
			"link": null,
			"locked": false,
			"text": "n = int(s, 2) # use the built-in `int()`function with base 2\nsteps = 0\n\nwhile n > 1:\n    if n % 2 == 0:\n        n //= 2 # use int division to avoid loss of precision with big numbers\n    else:\n        n += 1\n    steps += |\n\nreturn steps",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "n = int(s, 2) # use the built-in `int()`function with base 2\nsteps = 0\n\nwhile n > 1:\n    if n % 2 == 0:\n        n //= 2 # use int division to avoid loss of precision with big numbers\n    else:\n        n += 1\n    steps += |\n\nreturn steps",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
