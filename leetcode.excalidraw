			"isDeleted": false,
			"boundElements": [],
			"updated": 1774574373089,
			"link": null,
			"locked": false,
			"text": "brute force:\n- look for smallest number\n- max sequence length = 0\n- then look for smallest number+1\n- if found, increment msl\n- else, look for the next smallest (repeat)\n\nbf won't work bc of the constraints",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "brute force:\n- look for smallest number\n- max sequence length = 0\n- then look for smallest number+1\n- if found, increment msl\n- else, look for the next smallest (repeat)\n\nbf won't work bc of the constraints",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "PiKatDGk",
			"type": "text",
			"x": 6770.778547355308,
			"y": 9875.785103177051,
			"width": 535.87890625,
