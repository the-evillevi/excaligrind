			"isDeleted": false,
			"boundElements": [],
			"updated": 1773547629770,
			"link": null,
			"locked": false,
			"text": "class Solution:\n    def moveZeroes(self, nums: List[int]) -> None:\n        \"\"\"\n        Do not return anything, modify nums in-place instead.\n        \"\"\"\n        if len(nums) == 1:\n            return\n\n        idx1 = 0\n        idx2 = 1\n\n        while idx1 < len(nums) and idx2 < len(nums):\n            if nums[idx1] == 0:\n                if nums[idx2] != 0:\n                    nums[idx1], nums[idx2] = nums[idx2], nums[idx1]\n                    idx1 += 1\n                    idx2 += 1\n                else:\n                    idx2 += 1\n            else:\n                idx1 += 1\n                idx2 += 1\n        ",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "class Solution:\n    def moveZeroes(self, nums: List[int]) -> None:\n        \"\"\"\n        Do not return anything, modify nums in-place instead.\n        \"\"\"\n        if len(nums) == 1:\n            return\n\n        idx1 = 0\n        idx2 = 1\n\n        while idx1 < len(nums) and idx2 < len(nums):\n            if nums[idx1] == 0:\n                if nums[idx2] != 0:\n                    nums[idx1], nums[idx2] = nums[idx2], nums[idx1]\n                    idx1 += 1\n                    idx2 += 1\n                else:\n                    idx2 += 1\n            else:\n                idx1 += 1\n                idx2 += 1\n        ",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
