			"updated": 1772242907382,
			"link": null,
			"locked": false,
			"text": "approach 2: nested for loops\n\nproblem contrainsts:\n1 <= haystack.length, needle.length <= 10**4\nhaystack and needle consist of only lowercase English characters.\n",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "approach 2: nested for loops\n\nproblem contrainsts:\n1 <= haystack.length, needle.length <= 10**4\nhaystack and needle consist of only lowercase English characters.\n",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "XtoGquJc",
			"type": "text",
			"x": 3168.877566844337,
			"y": 2251.182394322089,
			"width": 445.1953125,
			"height": 475,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0L",
			"roundness": null,
			"seed": 1869672127,
			"version": 3,
			"versionNonce": 1982171903,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772242914760,
			"link": null,
			"locked": false,
			"text": "class Solution:\n    def strStr(self, haystack: str, needle: str) -> int:\n        if len(needle) == 0:\n            return 0\n\n        if len(needle) > len(haystack):\n            return -1\n\n        for i in range(len(haystack) - len(needle) + 1):\n            for j in range(len(needle)):\n                if haystack[i + j] != needle[j]:\n                    break\n                \n                if j == len(needle) - 1:\n                    return i\n                continue\n        \n        return -1\n        ",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "class Solution:\n    def strStr(self, haystack: str, needle: str) -> int:\n        if len(needle) == 0:\n            return 0\n\n        if len(needle) > len(haystack):\n            return -1\n\n        for i in range(len(haystack) - len(needle) + 1):\n            for j in range(len(needle)):\n                if haystack[i + j] != needle[j]:\n                    break\n                \n                if j == len(needle) - 1:\n                    return i\n                continue\n        \n        return -1\n        ",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
