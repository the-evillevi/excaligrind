		},
		{
			"id": "CWRMVNBt",
			"type": "text",
			"x": 4363.12704082463,
			"y": 333.94793646686014,
			"width": 681.474609375,
			"height": 250,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0N",
			"roundness": null,
			"seed": 1494664454,
			"version": 418,
			"versionNonce": 658653062,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772475350994,
			"link": null,
			"locked": false,
			"text": "given a `n x n` binary `grid`, in one step you can choose two adjacent rows of\nthe grid and swap them.\n\na grid is said to be valid if all the cells above the main diagonal are zeroes\n\nreturn the _minimum number of steps_ needed to make the grid valid, \nor *-1* if the grid cannot be valid.\n\nthe main diagonal of a grid is the diagonal that starts at cell `(1, 1)`\nand ends at cell `(n, n)`.",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "given a `n x n` binary `grid`, in one step you can choose two adjacent rows of\nthe grid and swap them.\n\na grid is said to be valid if all the cells above the main diagonal are zeroes\n\nreturn the _minimum number of steps_ needed to make the grid valid, \nor *-1* if the grid cannot be valid.\n\nthe main diagonal of a grid is the diagonal that starts at cell `(1, 1)`\nand ends at cell `(n, n)`.",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "PiMZVQUd",
			"type": "text",
			"x": 4359.390734387724,
			"y": 680.1789996204025,
			"width": 344.091796875,
			"height": 225,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0O",
			"roundness": null,
			"seed": 514103578,
			"version": 166,
			"versionNonce": 455352538,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772475298215,
			"link": null,
			"locked": false,
			"text": "e.g. 1\ninput: grid = [[0, 0, 1], [1, 1, 0], [1, 0, 0]]\noutput: 3\n\nexplanation:\n- step 0: [[0, 0, 1], [1, 1, 0], [1, 0, 0]]\n- step 1: [[1, 1, 0], [0, 0, 1], [1, 0, 0]]\n- step 2: [[1, 1, 0], [1, 0, 0], [0, 0, 1]]\n- step 3: [[1, 0, 0], [1, 1, 0], [0, 0, 1]]",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "e.g. 1\ninput: grid = [[0, 0, 1], [1, 1, 0], [1, 0, 0]]\noutput: 3\n\nexplanation:\n- step 0: [[0, 0, 1], [1, 1, 0], [1, 0, 0]]\n- step 1: [[1, 1, 0], [0, 0, 1], [1, 0, 0]]\n- step 2: [[1, 1, 0], [1, 0, 0], [0, 0, 1]]\n- step 3: [[1, 0, 0], [1, 1, 0], [0, 0, 1]]",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
