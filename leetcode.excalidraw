		{
			"id": "cSZhbpv1",
			"type": "text",
			"x": 3195.5910634319844,
			"y": 1225.6164166313365,
			"width": 746.318359375,
			"height": 775,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "b0H",
			"roundness": null,
			"seed": 2131897119,
			"version": 4,
			"versionNonce": 1840893937,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772241201393,
			"link": null,
			"locked": false,
			"text": "class Solution:\n    def strStr(self, haystack: str, needle: str) -> int:\n        if len(needle) == 0:\n            return 0\n\n        h_idx = 0\n        n_idx = 0\n\n        while h_idx < len(haystack):\n            print(\"------------------------------\")\n            print(f\"h_idx={h_idx}, n_idx={n_idx}\")\n            print(f\"needle[n_idx] == haystack[h_idx]={needle[n_idx] == haystack[h_idx]}\")\n            print(f\"needle[n_idx]={needle[n_idx]}, haystack[h_idx]={haystack[h_idx]}\")\n            if needle[n_idx] == haystack[h_idx]:\n                print(\"continue looking for needle, increase both idxs\")\n                n_idx += 1\n                h_idx += 1\n\n                if n_idx == len(needle):\n                    print(\"needle is complete\")\n                    print(f\"n_idx == len(needle)={n_idx == len(needle)}\")\n                    return h_idx - len(needle)\n            else:\n                print(\"reset n_idx, increase h_idx\")\n                h_idx -= n_idx\n                n_idx = 0\n                \n            print(f\"h_idx={h_idx}, n_idx={n_idx}\")\n        \n        return -1\n        ",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "class Solution:\n    def strStr(self, haystack: str, needle: str) -> int:\n        if len(needle) == 0:\n            return 0\n\n        h_idx = 0\n        n_idx = 0\n\n        while h_idx < len(haystack):\n            print(\"------------------------------\")\n            print(f\"h_idx={h_idx}, n_idx={n_idx}\")\n            print(f\"needle[n_idx] == haystack[h_idx]={needle[n_idx] == haystack[h_idx]}\")\n            print(f\"needle[n_idx]={needle[n_idx]}, haystack[h_idx]={haystack[h_idx]}\")\n            if needle[n_idx] == haystack[h_idx]:\n                print(\"continue looking for needle, increase both idxs\")\n                n_idx += 1\n                h_idx += 1\n\n                if n_idx == len(needle):\n                    print(\"needle is complete\")\n                    print(f\"n_idx == len(needle)={n_idx == len(needle)}\")\n                    return h_idx - len(needle)\n            else:\n                print(\"reset n_idx, increase h_idx\")\n                h_idx -= n_idx\n                n_idx = 0\n                \n            print(f\"h_idx={h_idx}, n_idx={n_idx}\")\n        \n        return -1\n        ",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
