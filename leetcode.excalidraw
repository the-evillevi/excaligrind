			"text": "approach 1: keep track of non-alternating bits",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "approach 1: keep track of non-alternating bits",
