		{
			"id": "Bzd904Yj",
			"type": "text",
			"x": -7.563494002715856,
			"y": 1886.2426464876949,
			"width": 360.6640625,
			"height": 375,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"frameId": null,
			"index": "aX",
			"roundness": null,
			"seed": 1735782387,
			"version": 438,
			"versionNonce": 1409836669,
			"isDeleted": false,
			"boundElements": [],
			"updated": 1772072922350,
			"link": null,
			"locked": false,
			"text": "left = 0\nright = 1\nmax_profit = -1\n\nwhile right < len(prices):\n    profit = prices[right] - prices[left]\n    \n    if profit > 0:\n        max_profit = max(max_profit, profit)\n    else:\n        left = right\n    \n    right += 1\n\nreturn max(max_profit, 0)",
			"fontSize": 20,
			"fontFamily": 5,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "left = 0\nright = 1\nmax_profit = -1\n\nwhile right < len(prices):\n    profit = prices[right] - prices[left]\n    \n    if profit > 0:\n        max_profit = max(max_profit, profit)\n    else:\n        left = right\n    \n    right += 1\n\nreturn max(max_profit, 0)",
			"autoResize": true,
			"lineHeight": 1.25,
			"hasTextLink": false,
			"rawText": ""
		},
		{
			"id": "O5XmqVKX",
			"type": "text",
			"x": 1037.4315517085563,
			"y": 251.93816252272393,
			"width": 650.337890625,
			"height": 90,
			"angle": 0,
			"strokeColor": "#ffffff",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 2,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
